{
  "primitive": {
    "color": {
      "neutral": {
        "0":   { "$type": "color", "$value": "#ffffff" },
        "100": { "$type": "color", "$value": "#f4f4f5" },
        "200": { "$type": "color", "$value": "#e4e4e7" },
        "500": { "$type": "color", "$value": "#71717a" },
        "800": { "$type": "color", "$value": "#27272a" },
        "900": { "$type": "color", "$value": "#18181b" },
        "950": { "$type": "color", "$value": "#09090b" }
      },
      "red": {
        "500": { "$type": "color", "$value": "#ef4444" },
        "700": { "$type": "color", "$value": "#b91c1c" }
      }
    },
    "radius": {
      "md": { "$type": "dimension", "$value": "8px" }
    }
  },
  "light": {
    "background":           { "$type": "color", "$value": "{color.neutral.0}" },
    "foreground":           { "$type": "color", "$value": "{color.neutral.950}" },
    "primary":              { "$type": "color", "$value": "{color.neutral.900}" },
    "primary-foreground":   { "$type": "color", "$value": "{color.neutral.0}" },
    "secondary":            { "$type": "color", "$value": "{color.neutral.100}" },
    "secondary-foreground": { "$type": "color", "$value": "{color.neutral.900}" },
    "destructive":          { "$type": "color", "$value": "{color.red.500}" },
    "border":               { "$type": "color", "$value": "{color.neutral.200}" },
    "muted-foreground":     { "$type": "color", "$value": "{color.neutral.500}" },
    "radius":               { "$type": "dimension", "$value": "{radius.md}" }
  },
  "dark": {
    "background":           { "$type": "color", "$value": "{color.neutral.950}" },
    "foreground":           { "$type": "color", "$value": "{color.neutral.0}" },
    "primary":              { "$type": "color", "$value": "{color.neutral.100}" },
    "primary-foreground":   { "$type": "color", "$value": "{color.neutral.900}" },
    "secondary":            { "$type": "color", "$value": "{color.neutral.800}" },
    "secondary-foreground": { "$type": "color", "$value": "{color.neutral.0}" },
    "destructive":          { "$type": "color", "$value": "{color.red.700}" },
    "border":               { "$type": "color", "$value": "{color.neutral.800}" },
    "muted-foreground":     { "$type": "color", "$value": "{color.neutral.500}" },
    "radius":               { "$type": "dimension", "$value": "{radius.md}" }
  }
}
