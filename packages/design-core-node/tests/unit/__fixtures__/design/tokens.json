{
	"primitive": {
		"color": {
			"white": {
				"$type": "color",
				"$value": "#ffffff"
			},
			"neutral": {
				"100": {
					"$type": "color",
					"$value": "#f5f5f5"
				},
				"900": {
					"$type": "color",
					"$value": "#171717"
				}
			}
		},
		"border-radius": {
			"lg": {
				"$type": "borderRadius",
				"$value": "10px"
			}
		}
	},
	"light": {
		"primary": {
			"$type": "color",
			"$value": "{color.neutral.900}"
		},
		"primary-foreground": {
			"$type": "color",
			"$value": "{color.white}"
		},
		"radius": {
			"$type": "borderRadius",
			"$value": "{border-radius.lg}"
		}
	},
	"dark": {
		"primary": {
			"$type": "color",
			"$value": "{color.neutral.100}"
		},
		"primary-foreground": {
			"$type": "color",
			"$value": "{color.neutral.900}"
		},
		"radius": {
			"$type": "borderRadius",
			"$value": "{border-radius.lg}"
		}
	}
}
