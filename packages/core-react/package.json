{
	"name": "@brrritscold/core-react",
	"version": "0.0.0",
	"private": true,
	"description": "The component library: shadcn (Base UI) React components on Tailwind v4, themed from one design token file and linked to the design system library in Penpot.",
	"license": "MIT",
	"author": "Blaine Richardson",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bRRRITSCOLD/ts-packages.git",
		"directory": "packages/core-react"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./icons": {
			"types": "./dist/icons.d.ts",
			"default": "./dist/icons.js"
		},
		"./data-table": {
			"types": "./dist/data-table.d.ts",
			"default": "./dist/data-table.js"
		},
		"./styles.css": "./dist/styles.css",
		"./tokens.json": "./dist/tokens.json"
	},
	"scripts": {
		"build": "rm -rf dist && pnpm build:styles && tsc -p tsconfig.build.json",
		"build:styles": "tsx scripts/build-styles.ts",
		"clean": "rm -rf dist storybook-static .turbo",
		"lint": "biome check --write",
		"lint:check": "biome check",
		"storybook": "pnpm build:styles && storybook dev -p 6006",
		"storybook:build": "pnpm build:styles && storybook build",
		"test:stories": "pnpm build:styles && vitest run --project stories",
		"test:stories:watch": "pnpm build:styles && vitest --project stories",
		"test:unit": "vitest run --project unit",
		"test:unit:watch": "vitest --project unit",
		"typecheck": "tsc -p ./tsconfig.json"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.68.0",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"keywords": [
		"brrritscold",
		"react",
		"design-system"
	],
	"devDependencies": {
		"@brrritscold/design-core-js": "workspace:*",
		"@brrritscold/design-core-node": "workspace:*",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/react-vite": "^10.6.5",
		"@tailwindcss/node": "^4.3.4",
		"@tailwindcss/vite": "^4.3.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"@vitest/browser-playwright": "4.1.12",
		"jsdom": "^30.1.3",
		"playwright": "^1.64.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"storybook": "^10.6.5",
		"style-dictionary": "^5.8.0",
		"tailwindcss": "^4.3.4",
		"vite": "^8.3.5"
	}
}
