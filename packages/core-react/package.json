{
	"name": "@brrritscold/core-react",
	"version": "1.0.0",
	"description": "The component library: shadcn (Base UI) React components on Tailwind v4, themed from one design token file and linked to the design system library in Penpot.",
	"license": "MIT",
	"author": "Blaine Richardson",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bRRRITSCOLD/ts-packages.git",
		"directory": "packages/core-react"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./icons": {
			"types": "./dist/icons.d.ts",
			"default": "./dist/icons.js"
		},
		"./data-table": {
			"types": "./dist/data-table.d.ts",
			"default": "./dist/data-table.js"
		},
		"./styles.css": "./dist/styles.css",
		"./tokens.json": "./dist/tokens.json",
		"./library.snapshot.json": "./dist/library.snapshot.json",
		"./testing": {
			"types": "./dist/testing.d.ts",
			"default": "./dist/testing.js"
		}
	},
	"scripts": {
		"build": "rm -rf dist && pnpm build:styles && tsc -p tsconfig.build.json && tsx scripts/build-icons.ts",
		"build:styles": "tsx scripts/build-styles.ts",
		"clean": "rm -rf dist storybook-static test-results playwright-report code-manifest.json .turbo",
		"drift:check": "design-drift check --manifest code-manifest.json --snapshot design/library.snapshot.json --tokens tokens/tokens.json --config design/drift.config.json",
		"drift:manifest": "design-drift manifest --entry dist/index.d.ts --icons dist/icons.d.ts --out code-manifest.json",
		"lint": "biome check --write",
		"lint:check": "biome check",
		"storybook": "pnpm build:styles && storybook dev -p 6006",
		"storybook:build": "pnpm build:styles && storybook build",
		"test:integration": "pnpm storybook:build && playwright test -c playwright.integration.config.ts",
		"test:integration:ci": "pnpm test:integration:setup && { pnpm test:integration; code=$?; pnpm test:integration:teardown; exit $code; }",
		"test:integration:setup": "tsx ./tests/integration/__utils__/setup.ts",
		"test:integration:teardown": "tsx ./tests/integration/__utils__/teardown.ts",
		"test:integration:watch": "pnpm storybook:build && playwright test -c playwright.integration.config.ts --ui",
		"test:stories": "pnpm build:styles && vitest run --project stories",
		"test:stories:watch": "pnpm build:styles && vitest --project stories",
		"test:unit": "vitest run --project unit",
		"test:unit:watch": "vitest --project unit",
		"typecheck": "tsc -p ./tsconfig.json"
	},
	"peerDependencies": {
		"@playwright/test": "^1.40.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwindcss": "^4.0.0"
	},
	"peerDependenciesMeta": {
		"@playwright/test": {
			"optional": true
		}
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@tanstack/react-table": "^9.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"lucide-react": "1.68.0",
		"react-day-picker": "^10.0.2",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"keywords": [
		"brrritscold",
		"react",
		"design-system"
	],
	"devDependencies": {
		"@brrritscold/design-core-js": "workspace:*",
		"@brrritscold/design-core-node": "workspace:*",
		"@playwright/test": "^1.64.1",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/react-vite": "^10.6.5",
		"@tailwindcss/node": "^4.3.4",
		"@tailwindcss/vite": "^4.3.4",
		"@testing-library/react": "^16.3.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"@vitest/browser-playwright": "4.1.12",
		"jsdom": "^30.1.3",
		"playwright": "^1.64.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"storybook": "^10.6.5",
		"style-dictionary": "^5.8.0",
		"tailwindcss": "^4.3.4",
		"vite": "^8.3.5"
	}
}
