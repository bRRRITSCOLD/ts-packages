{
	"name": "@brrritscold/testing-core-js",
	"version": "0.1.0",
	"description": "Runtime-agnostic test helpers.",
	"license": "MIT",
	"author": "Blaine Richardson",
	"homepage": "https://brrritscold.github.io/ts-packages/modules/_brrritscold_testing-core-js.html",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bRRRITSCOLD/ts-packages.git",
		"directory": "packages/testing-core-js"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.mjs"
		},
		"./common": {
			"import": {
				"types": "./dist/common.d.ts",
				"default": "./dist/common.mjs"
			},
			"require": {
				"types": "./dist/common.d.cts",
				"default": "./dist/common.cjs"
			},
			"default": "./dist/common.mjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"clean": "rm -rf dist .turbo",
		"lint": "biome check --write",
		"lint:check": "biome check",
		"test:e2e": "mocha --require tsx tests/**/*.e2e.test.ts --recursive --timeout 99999999  --exit",
		"test:e2e:watch": "nodemon --config ./nodemon.e2e.test.json",
		"test:unit": "mocha --require tsx tests/**/*.unit.test.ts --recursive --timeout 99999999  --exit",
		"test:unit:watch": "nodemon --config ./nodemon.unit.test.json",
		"typecheck": "tsc -p ./tsconfig.json"
	},
	"dependencies": {
		"lodash": "^4.17.21"
	},
	"devDependencies": {
		"@types/lodash": "^4.17.16"
	},
	"keywords": [
		"brrritscold",
		"typescript"
	]
}
