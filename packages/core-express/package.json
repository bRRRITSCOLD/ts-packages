{
	"name": "@brrritscold/core-express",
	"version": "0.2.0",
	"description": "Express middlewares and helpers: JWT middleware, typed OpenAPI router, server creation.",
	"license": "MIT",
	"author": "Blaine Richardson",
	"homepage": "https://brrritscold.github.io/ts-packages/modules/_brrritscold_core-express.html",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bRRRITSCOLD/ts-packages.git",
		"directory": "packages/core-express"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		"./error": {
			"import": {
				"types": "./dist/error.d.ts",
				"default": "./dist/error.mjs"
			},
			"require": {
				"types": "./dist/error.d.cts",
				"default": "./dist/error.cjs"
			},
			"default": "./dist/error.mjs"
		},
		"./middlewares/jwt": {
			"import": {
				"types": "./dist/middlewares/jwt.d.ts",
				"default": "./dist/middlewares/jwt.mjs"
			},
			"require": {
				"types": "./dist/middlewares/jwt.d.cts",
				"default": "./dist/middlewares/jwt.cjs"
			},
			"default": "./dist/middlewares/jwt.mjs"
		},
		"./openapi": {
			"import": {
				"types": "./dist/openapi.d.ts",
				"default": "./dist/openapi.mjs"
			},
			"require": {
				"types": "./dist/openapi.d.cts",
				"default": "./dist/openapi.cjs"
			},
			"default": "./dist/openapi.mjs"
		},
		"./utils/create-server": {
			"import": {
				"types": "./dist/utils/create-server.d.ts",
				"default": "./dist/utils/create-server.mjs"
			},
			"require": {
				"types": "./dist/utils/create-server.d.cts",
				"default": "./dist/utils/create-server.cjs"
			},
			"default": "./dist/utils/create-server.mjs"
		},
		"./utils/jwt": {
			"import": {
				"types": "./dist/utils/jwt.d.ts",
				"default": "./dist/utils/jwt.mjs"
			},
			"require": {
				"types": "./dist/utils/jwt.d.cts",
				"default": "./dist/utils/jwt.cjs"
			},
			"default": "./dist/utils/jwt.mjs"
		}
	},
	"scripts": {
		"build": "tsup",
		"clean": "rm -rf dist .turbo",
		"lint": "biome check --write",
		"lint:check": "biome check",
		"test:e2e": "vitest run --project e2e",
		"test:e2e:watch": "vitest --project e2e",
		"test:integration": "vitest run --project integration",
		"test:integration:ci": "npm run test:integration:setup && npm run test:integration && npm run test:integration:teardown",
		"test:integration:setup": "tsx ./tests/integration/__utils__/setup.ts",
		"test:integration:teardown": "tsx ./tests/integration/__utils__/teardown.ts",
		"test:integration:watch": "vitest --project integration",
		"test:unit": "vitest run --project unit",
		"test:unit:watch": "vitest --project unit",
		"typecheck": "tsc -p ./tsconfig.json"
	},
	"dependencies": {
		"@brrritscold/core-js": "workspace:^",
		"@brrritscold/core-node": "workspace:^",
		"@types/cors": "^2.8.19",
		"@types/swagger-ui-express": "^4.1.8",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"dotenv-safe": "^9.1.0",
		"express": "^5.1.0",
		"openapi-typescript-helpers": "^0.0.15",
		"swagger-ui-express": "^5.0.1",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@brrritscold/testing-core-node": "workspace:^",
		"@types/dotenv-safe": "^9.1.0",
		"@types/express": "^5.0.5",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.1.4"
	},
	"keywords": [
		"brrritscold",
		"typescript"
	]
}
