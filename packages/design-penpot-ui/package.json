		"test:unit:watch": "vitest --project unit",
		"typecheck": "tsc -p ./tsconfig.json"
	},
	"dependencies": {
		"@brrritscold/design-core-js": "workspace:^"
	},
	"devDependencies": {
		"@penpot/plugin-types": "1.5.0",
		"jsdom": "^30.1.3"
	},
	"keywords": [
		"brrritscold",
		"typescript"
	]
