{
	"name": "@brrritscold/design-penpot-ui",
	"version": "0.1.0",
	"private": true,
	"description": "The link inspector Penpot plugin (manifest, plugin code, iframe UI) and the read-links.js link reader, both over one Penpot-shape adapter and the shared component-link resolver.",
	"license": "MIT",
	"author": "Blaine Richardson",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bRRRITSCOLD/ts-packages.git",
		"directory": "packages/design-penpot-ui"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"clean": "rm -rf dist .turbo",
		"lint": "biome check --write",
		"lint:check": "biome check",
