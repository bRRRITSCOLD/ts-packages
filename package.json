{
	"name": "brrritscold-ts-packages",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo run build",
		"changeset": "changeset",
		"check:entries": "node scripts/check-entries.mjs",
		"clean": "turbo run clean && rm -rf node_modules",
		"docs:build": "typedoc",
		"docs:check": "typedoc && node scripts/readme-api.mjs --check",
		"docs:readme": "typedoc && node scripts/readme-api.mjs",
		"lint": "biome check --write",
		"lint:check": "biome check",
		"prepare": "husky",
		"release": "turbo run build && changeset publish",
		"test:integration": "turbo run test:integration:ci --concurrency=1",
		"test:stories": "turbo run test:stories",
		"test:unit": "turbo run test:unit",
		"typecheck": "turbo run typecheck",
		"version-packages": "changeset version && biome format --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^2.29.7",
		"@types/node": "^22.15.19",
		"husky": "^9.1.7",
		"lint-staged": "^16.0.0",
		"tsup": "^8.5.0",
		"tsx": "^4.19.4",
		"turbo": "^2.5.8",
		"typedoc": "^0.28.5",
		"typescript": "^5.8.3",
		"vitest": "^4.1.12"
	},
	"lint-staged": {
		"*.{js,ts,json}": "biome check --write --no-errors-on-unmatched"
	},
	"license": "MIT"
}
