{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["src/**", "tsup.config.ts", "tsconfig*.json", "package.json"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"dependsOn": ["^build"]
		},
		"test:unit": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:integration:ci": {
			"dependsOn": ["^build"],
			"cache": false,
			"passThroughEnv": ["DEBUG", "DOCKER_HOST", "TESTCONTAINERS_*"]
		},
		"generate:docs": {
			"outputs": ["docs/**"]
		},
		"clean": {
			"cache": false
		}
	}
}
